# Copia este archivo como .env y llena los valores.
# El pago es por transferencia (QR / Nequi) y se configura en data/restaurantes.json.
# Si dejas WHATSAPP vacío, el panel abre WhatsApp con el mensaje listo para enviarlo a mano.

PORT=3000
# URL pública donde queda la app (en producción, tu dominio con https)
BASE_URL=http://localhost:3000

# Clave para entrar al panel de pedidos: /admin.html
ADMIN_KEY=cambia-esta-clave

# ---------- WOMPI (OPCIONAL, sin uso: solo si un restaurante usa "pago": {"tipo": "wompi"}) ----------
# sandbox = pruebas, production = dinero real
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Si cada restaurante tiene su PROPIA cuenta Wompi (el dinero va a cuentas distintas),
# agrega las claves con el slug del restaurante en mayúsculas y guiones bajos.
# Ejemplo para el slug "hard-burgers":
# WOMPI_PUBLIC_KEY_HARD_BURGERS=
# WOMPI_PRIVATE_KEY_HARD_BURGERS=
# WOMPI_INTEGRITY_SECRET_HARD_BURGERS=
# WOMPI_EVENTS_SECRET_HARD_BURGERS=

# ---------- WHATSAPP CLOUD API (Meta) · opcional, para que el aviso salga solo ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Nombre e idioma de la plantilla aprobada en Meta para avisar al cliente
WHATSAPP_TEMPLATE_CLIENTE=pago_confirmado
# Plantilla (opcional) para avisarle al restaurante que entró un pedido pagado
WHATSAPP_TEMPLATE_RESTAURANTE=nuevo_pedido
WHATSAPP_TEMPLATE_LANG=es
